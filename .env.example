# Supabase 项目地址，例如：https://xxxx.supabase.co
SUPABASE_URL=

# Supabase 后端 Secret key，格式通常为 sb_secret_...
# 只能配置在 Vercel 环境变量中，禁止写入网页或提交到 GitHub。
SUPABASE_SECRET_KEY=

# 管理员口令。仅管理员本人保存，至少 8 位。
ADMIN_PASSWORD=

# 会话签名密钥。建议使用 40 位以上随机字符串。
SESSION_SECRET=

# v1.4 起共享成员改为数据库中的独立账号，旧 TEAM_PASSWORD 不再用于登录。
